# No pongas secretos de DeepSeek en la aplicación móvil.
# Esta URL se utiliza únicamente al pulsar "Subir datos".
EXPO_PUBLIC_SYNC_BASE_URL=https://tu-servidor.example.com

# Identificador visible del periférico BLE creado por el firmware incluido.
EXPO_PUBLIC_BLE_DEVICE_NAME=MLX90614-ESP32

# Solo para pruebas: esta clave queda incluida en la app compilada.
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-chat

# API histórica que DeepSeek consulta mediante herramientas GET.
EXPO_PUBLIC_TEMPERATURE_API_BASE_URL=https://tu-servidor.example.com
